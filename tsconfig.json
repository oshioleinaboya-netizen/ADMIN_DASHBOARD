{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "es6",
      "dom"
    ],
    "sourceMap": true,
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@support/*": [
        "xboy/support/*"
      ]
    },
    "types": [
      "cypress",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "cypress.config.js"
  ]
}